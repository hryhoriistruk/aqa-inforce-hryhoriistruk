{
  "name": "aqa-inforce-hryhoriistruk",
  "version": "1.0.0",
  "description": "Cypress UI + API tests for https://automationintesting.online/ (Playwright/pytest version in ./python)",
  "private": true,
  "license": "MIT",
  "author": "Hryhorii Struk",
  "keywords": [
    "qa",
    "automation",
    "cypress",
    "playwright",
    "pytest",
    "restful-booker"
  ],
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "cypress run",
    "test:headed": "cypress run --headed",
    "test:ui": "cypress run --spec cypress/e2e/user-spec.cy.js",
    "test:api": "cypress run --spec cypress/e2e/admin-spec.cy.js",
    "lint:py": "cd python && flake8 . && black --check . && isort --check-only .",
    "format:py": "cd python && black . && isort .",
    "test:py": "cd python && pytest"
  },
  "devDependencies": {
    "cypress": "^13.15.0"
  }
}
